# 工具二进制与模板库（数百 MB，不入版本库；由 install_tools.py 重建）
pentest-orchestrator/tools/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# 会话与审计产物（含真实授权信息，不入库）
pentest-orchestrator/.sessions/

# 靶场临时文件
pentest-orchestrator/_lab/

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# 本地备份
*.real.bak
*.bak

# 登录态凭据（P4）—— 含真实会话 Cookie，绝不可入库
cred*.json
cred*.txt
*.cred
.cred*
pentest-orchestrator/_cred*

# 真实目标取证产物（与 .sessions/ 同类：含真实主机名、路径、响应元数据，属本地产物）
# 规则检查单资产快照
pentest-orchestrator/rules_*.json
# 真实目标运行日志（_rerun_* / _r012_* / _r013_* 等）
pentest-orchestrator/_*.log
# 真实目标报告附录（提交稿素材，按目标生成）
pentest-orchestrator/_appendix_*.md
